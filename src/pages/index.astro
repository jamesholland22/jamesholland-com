---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StickerHeading from '../components/StickerHeading.astro';
import Sticker from '../components/Sticker.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import GraphicSticker from '../components/GraphicSticker.astro';

const CATEGORIES = ['Client work', 'Agency tools & tech', 'Side projects'] as const;

const allWork = await getCollection('work', ({ data }) => !data.draft);

const sortedWork = allWork.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) return a.data.order - b.data.order;
  if (a.data.order !== undefined) return -1;
  if (b.data.order !== undefined) return 1;
  return b.data.year - a.data.year;
});

const byCategory = CATEGORIES
  .map(cat => ({
    category: cat,
    id: cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-$/, ''),
    entries: sortedWork.filter(e => e.data.category === cat),
  }))
  .filter(g => g.entries.length > 0);

// Filter chips for the client-work grid: tags used by 2+ case studies
const clientEntries = sortedWork.filter(e => e.data.category === 'Client work');
const tagCounts = new Map<string, number>();
for (const e of clientEntries) {
  for (const t of e.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const filterTags = [...tagCounts.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 7)
  .map(([t]) => t);
---

<BaseLayout
  title="James Holland"
  description="Award-winning communications and marketing strategy for brands and agencies."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <StickerHeading
        parts={[
          { sticker: "Award winning", color: "yellow", rotate: -2 },
          " communications and marketing strategy for ",
          { sticker: "incredible", color: "pink", rotate: 2 },
          " brands and agencies."
        ]}
        as="h1"
        class="hero__heading"
      />
      <p class="hero__bio">
        I'm James, a communications and marketing strategist helping ambitious agencies and
        brands tell stories that inspire action. I work on
        positioning, messaging, campaigns, and the kind of thinking that makes
        everything else easier.
      </p>
      <div class="hero__links">
        <a href="mailto:hello@jamesholland.com" class="hero__cta">Get in touch</a>
        <a href="https://www.linkedin.com/in/meet-james-holland/" class="hero__secondary">LinkedIn →</a>
      </div>
    </div>
  </section>

  <!-- Work sections -->
  {byCategory.map(({ category, id, entries }) => (
    <section class="work-section" id={id}>
      <div class="container">
        <h2 class="work-section__heading">
          {category === 'Client work' && (
            <Sticker label="CLIENT WORK" color="green" rotate={-1} />
          )}
          {category === 'Agency tools & tech' && (
            <Sticker label="AGENCY TOOLS & TECH" color="blue" rotate={-1} />
          )}
          {category === 'Side projects' && (
            <Sticker label="SIDE PROJECTS" color="orange" rotate={1} />
          )}
          {category === 'Client work' && (
            <div class="work-filter" role="group" aria-label="Filter case studies by type">
              <button class="work-filter__chip work-filter__chip--active" data-filter="all" aria-pressed="true">All</button>
              {filterTags.map((tag) => (
                <button class="work-filter__chip" data-filter={tag} aria-pressed="false">{tag}</button>
              ))}
            </div>
          )}
        </h2>
        <div class="work-grid">
          {entries.map((entry) => (
            <CaseStudyCard
              slug={entry.id.replace(/\.mdx?$/, '')}
              title={entry.data.title}
              client={entry.data.client}
              year={entry.data.year}
              tags={entry.data.tags}
              coverImage={entry.data.coverImage}
              coverVideo={entry.data.coverVideo}
              summary={entry.data.summary}
              featured={entry.data.featured}
              agency={entry.data.agency}
            />
          ))}
          {category === 'Client work' && (
            <>
              <div class="grid-filler" aria-hidden="true"><GraphicSticker name="star" color="yellow" rotate={-8} /></div>
              <div class="grid-filler" aria-hidden="true"><GraphicSticker name="sparkle" color="pink" rotate={6} /></div>
              <div class="grid-filler" aria-hidden="true"><GraphicSticker name="lightning" color="blue" rotate={-5} /></div>
            </>
          )}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  /* ── Hero ────────────────────────────────────────────── */
  .hero {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .hero__heading {
    max-width: 18ch;
    margin-bottom: var(--space-8);
  }

  .hero__bio {
    font-size: var(--text-lg);
    max-width: 50ch;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .hero__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .hero__cta {
    display: inline-block;
    padding: 0.65em 1.5em;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-md);
    transition: opacity var(--transition-fast);
  }

  .hero__cta:hover {
    opacity: 0.8;
  }

  .hero__secondary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .hero__secondary:hover {
    color: var(--color-text);
  }

  /* ── Work sections ───────────────────────────────────── */
  .work-section {
    padding-bottom: var(--space-24);
    scroll-margin-top: 6rem;
  }

  .work-section__heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Tag filter chips ────────────────────────────────── */
  .work-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .work-filter__chip {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.35em 0.9em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: var(--color-surface);
    cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
  }

  .work-filter__chip:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .work-filter__chip--active {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }

  .work-grid :global(.card--filtered-out) {
    display: none;
  }

  /* Decorative fillers for masonry pockets — placed by JS, hidden otherwise */
  .grid-filler {
    display: none;
    align-items: center;
    justify-content: center;
  }

  .work-grid.is-masonry .grid-filler.is-placed {
    display: flex;
  }

  .grid-filler > :global(*) {
    transform: scale(2.2);
  }

  /* ── Work grid: 1 → 2 → 3 columns, masonry-packed ────── */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12) var(--space-8);
  }

  @media (min-width: 40rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-12) var(--space-6);
    }
  }

  /* Masonry mode (multi-column only): fine-grained implicit rows let JS give
     each card a row-span matching its content, so short neighbours don't
     leave holes beside tall featured cards. */
  @media (min-width: 40rem) {
    .work-grid.is-masonry {
      grid-auto-rows: 8px;
      grid-auto-flow: dense;
      row-gap: 0;
      align-items: start;
    }

    .work-grid.is-masonry :global(.card) {
      margin-bottom: var(--space-12);
    }
  }
</style>

<script>
  // Masonry packing: span each card across fine-grained implicit rows so
  // cards flow up to fill gaps beside taller (featured) neighbours.
  const ROW_UNIT = 8;

  function layoutGrid(grid: HTMLElement) {
    const nCols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
    grid.classList.toggle('is-masonry', nCols > 1);
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    if (nCols === 1) {
      cards.forEach(c => { c.style.gridRow = ''; c.style.gridColumn = ''; });
      return;
    }
    const margin = 48; // --space-12
    const colHeights = new Array(nCols).fill(0);

    // measure spans up front
    const queue = cards
      .filter(c => !c.classList.contains('card--filtered-out'))
      .map(card => {
        const kids = [...card.children] as HTMLElement[];
        const h = kids[kids.length - 1].getBoundingClientRect().bottom - kids[0].getBoundingClientRect().top;
        return {
          card,
          wide: card.classList.contains('card--featured') && nCols >= 2,
          span: Math.max(1, Math.ceil((h + margin) / ROW_UNIT)),
        };
      });
    cards.filter(c => c.classList.contains('card--filtered-out')).forEach(c => { c.style.gridRow = ''; c.style.gridColumn = ''; });

    const placed: {c0: number; c1: number; r0: number; r1: number}[] = [];

    const place = (item: typeof queue[0], col: number, start: number) => {
      const rowStart = Math.floor(start / ROW_UNIT) + 1;
      item.card.style.gridColumn = item.wide ? `${col + 1} / span 2` : `${col + 1}`;
      item.card.style.gridRow = `${rowStart} / span ${item.span}`;
      const bottom = rowStart - 1 + item.span;
      placed.push({c0: col, c1: item.wide ? col + 1 : col, r0: rowStart, r1: bottom + 1});
      colHeights[col] = bottom * ROW_UNIT;
      if (item.wide) colHeights[col + 1] = bottom * ROW_UNIT;
    };

    while (queue.length) {
      const item = queue[0];
      if (item.wide) {
        // best adjacent pair: lowest start, then least wasted hole
        let col = 0, start = Infinity, waste = Infinity;
        for (let i = 0; i <= nCols - 2; i++) {
          const s = Math.max(colHeights[i], colHeights[i + 1]);
          const w = Math.abs(colHeights[i] - colHeights[i + 1]);
          if (s < start || (s === start && w < waste)) { start = s; waste = w; col = i; }
        }
        // if aligning the pair wastes real space, pull a later single card
        // forward to fill the shorter column first
        if (waste > 12 * ROW_UNIT) {
          const shorter = colHeights[col] <= colHeights[col + 1] ? col : col + 1;
          const fillerIdx = queue.findIndex((q, i) => i > 0 && !q.wide && q.span * ROW_UNIT <= waste + 8 * ROW_UNIT);
          if (fillerIdx > 0) {
            const filler = queue.splice(fillerIdx, 1)[0];
            place(filler, shorter, colHeights[shorter]);
            continue;
          }
        }
        place(item, col, start);
      } else {
        let col = 0, best = Infinity;
        for (let i = 0; i < nCols; i++) if (colHeights[i] < best) { best = colHeights[i]; col = i; }
        place(item, col, best);
      }
      queue.shift();
    }

    // find leftover pockets from the final geometry and tuck stickers in
    const holes: {col: number; startRow: number; endRow: number}[] = [];
    for (let c = 0; c < nCols; c++) {
      const intervals = placed.filter(p => p.c0 <= c && c <= p.c1).sort((a, b) => a.r0 - b.r0);
      let cursor = 1;
      for (const iv of intervals) {
        if ((iv.r0 - cursor) * ROW_UNIT > 140) holes.push({col: c, startRow: cursor, endRow: iv.r0});
        cursor = Math.max(cursor, iv.r1);
      }
    }
    const fillers = [...grid.querySelectorAll<HTMLElement>('.grid-filler')];
    fillers.forEach(f => f.classList.remove('is-placed'));
    holes.slice(0, fillers.length).forEach((hole, i) => {
      const f = fillers[i];
      f.style.gridColumn = `${hole.col + 1}`;
      f.style.gridRow = `${hole.startRow} / ${hole.endRow}`;
      f.classList.add('is-placed');
    });
  }

  function layoutAllGrids() {
    document.querySelectorAll<HTMLElement>('.work-grid').forEach(layoutGrid);
  }

  let masonryRaf = 0;
  function scheduleLayout() {
    cancelAnimationFrame(masonryRaf);
    masonryRaf = requestAnimationFrame(layoutAllGrids);
  }

  document.addEventListener('astro:page-load', () => {
    layoutAllGrids();
    // re-pack once media/fonts settle and on resize
    window.addEventListener('load', scheduleLayout, { once: true });
    (document as any).fonts?.ready?.then(scheduleLayout);
    window.addEventListener('resize', scheduleLayout);
  });

  // Tag filter for the client-work grid
  function initWorkFilter() {
    const section = document.getElementById('client-work');
    if (!section) return;
    const chips = section.querySelectorAll<HTMLButtonElement>('.work-filter__chip');
    const cards = section.querySelectorAll<HTMLElement>('.work-grid .card');
    if (!chips.length) return;

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter;
        chips.forEach(c => {
          const active = c === chip;
          c.classList.toggle('work-filter__chip--active', active);
          c.setAttribute('aria-pressed', String(active));
        });
        cards.forEach(card => {
          const tags = (card.dataset.tags || '').split('|');
          const show = filter === 'all' || tags.includes(filter!);
          card.classList.toggle('card--filtered-out', !show);
        });
        scheduleLayout();
      });
    });
  }
  document.addEventListener('astro:page-load', initWorkFilter);
</script>
