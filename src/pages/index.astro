---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StickerHeading from '../components/StickerHeading.astro';
import Sticker from '../components/Sticker.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';

const CATEGORIES = ['Client work', 'Agency tools & tech', 'Side projects'] as const;

const allWork = await getCollection('work', ({ data }) => !data.draft || import.meta.env.DEV);

const sortedWork = allWork.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) return a.data.order - b.data.order;
  if (a.data.order !== undefined) return -1;
  if (b.data.order !== undefined) return 1;
  return b.data.year - a.data.year;
});

const byCategory = CATEGORIES
  .map(cat => ({
    category: cat,
    id: cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-$/, ''),
    entries: sortedWork.filter(e => e.data.category === cat),
  }))
  .filter(g => g.entries.length > 0);

// Filter chips for the client-work grid: tags used by 2+ case studies
const clientEntries = sortedWork.filter(e => e.data.category === 'Client work');
const tagCounts = new Map<string, number>();
for (const e of clientEntries) {
  for (const t of e.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const filterTags = [...tagCounts.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 7)
  .map(([t]) => t);
---

<BaseLayout
  title="James Holland"
  description="Award-winning communications and marketing strategy for brands and agencies."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <StickerHeading
        parts={[
          { sticker: "Award winning", color: "yellow", rotate: -2 },
          " communications and marketing strategy for ",
          { sticker: "incredible", color: "pink", rotate: 2 },
          " brands and agencies."
        ]}
        as="h1"
        class="hero__heading"
      />
      <p class="hero__bio">
        I'm James, a communications and marketing strategist helping ambitious agencies and
        brands tell stories that inspire action. I work on
        positioning, messaging, campaigns, and the kind of thinking that makes
        everything else easier.
      </p>
      <div class="hero__links">
        <a href="/contact" class="hero__cta">Get in touch</a>
        <a href="https://www.linkedin.com/in/meet-james-holland/" class="hero__secondary">LinkedIn →</a>
      </div>
    </div>
  </section>

  <!-- Work sections -->
  {byCategory.map(({ category, id, entries }) => (
    <section class="work-section" id={id}>
      <div class="container">
        <h2 class="work-section__heading">
          {category === 'Client work' && (
            <Sticker label="CLIENT WORK" color="green" rotate={-1} />
          )}
          {category === 'Agency tools & tech' && (
            <Sticker label="AGENCY TOOLS & TECH" color="blue" rotate={-1} />
          )}
          {category === 'Side projects' && (
            <Sticker label="SIDE PROJECTS" color="orange" rotate={1} />
          )}
          {category === 'Client work' && (
            <div class="work-filter" role="group" aria-label="Filter case studies by type">
              <button class="work-filter__chip work-filter__chip--active" data-filter="all" aria-pressed="true">All</button>
              {filterTags.map((tag) => (
                <button class="work-filter__chip" data-filter={tag} aria-pressed="false">{tag}</button>
              ))}
            </div>
          )}
        </h2>
        <div class="work-grid">
          {entries.map((entry) => (
            <CaseStudyCard
              slug={entry.id.replace(/\.mdx?$/, '')}
              title={entry.data.title}
              client={entry.data.client}
              year={entry.data.year}
              tags={entry.data.tags}
              coverImage={entry.data.coverImage}
              coverVideo={entry.data.coverVideo}
              summary={entry.data.summary}
              featured={entry.data.featured}
              agency={entry.data.agency}
            />
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  /* ── Hero ────────────────────────────────────────────── */
  .hero {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .hero__heading {
    max-width: 18ch;
    margin-bottom: var(--space-8);
  }

  .hero__bio {
    font-size: var(--text-lg);
    max-width: 50ch;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .hero__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .hero__cta {
    display: inline-block;
    padding: 0.65em 1.5em;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-md);
    transition: opacity var(--transition-fast);
  }

  .hero__cta:hover {
    opacity: 0.8;
  }

  .hero__secondary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .hero__secondary:hover {
    color: var(--color-text);
  }

  /* ── Work sections ───────────────────────────────────── */
  .work-section {
    padding-bottom: var(--space-24);
    scroll-margin-top: 6rem;
  }

  .work-section__heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Tag filter chips ────────────────────────────────── */
  .work-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .work-filter__chip {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.35em 0.9em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: var(--color-surface);
    cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
  }

  .work-filter__chip:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .work-filter__chip--active {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }

  .work-grid :global(.card--filtered-out) {
    display: none;
  }

  /* ── Work grid: 1 → 2 → 3 columns, masonry-packed ────── */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12) var(--space-8);
  }

  @media (min-width: 40rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-12) var(--space-6);
    }
  }

</style>

<script>
  // Row tiling: build explicit full rows — a featured card pairs with one
  // single-width card (whose summary unclamps to fill the taller row), and
  // all other rows hold a full set of single-width cards.
  function layoutGrid(grid: HTMLElement) {
    const nCols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    const reset = (c: HTMLElement) => {
      c.style.gridRow = ''; c.style.gridColumn = '';
      const s = c.querySelector<HTMLElement>('.card__summary');
      if (s) s.style.webkitLineClamp = '';
    };
    if (nCols === 1) { cards.forEach(reset); return; }

    const visible = cards.filter(c => !c.classList.contains('card--filtered-out'));
    cards.filter(c => c.classList.contains('card--filtered-out')).forEach(reset);
    visible.forEach(reset);

    const isWide = (c: HTMLElement) => c.classList.contains('card--featured');
    const queue = [...visible];
    let row = 1;
    let featuredRowCount = 0;
    const pairs: {featured: HTMLElement; single: HTMLElement}[] = [];

    while (queue.length) {
      let next = queue[0];
      // if filling a singles row would leave a later featured card without a
      // partner, bring that featured card's row forward instead
      if (!isWide(next)) {
        const singles = queue.filter(q => !isWide(q)).length;
        const featured = queue.length - singles;
        if (featured > 0 && singles - nCols < featured) {
          const fi = queue.findIndex(isWide);
          next = queue.splice(fi, 1)[0];
          queue.unshift(next);
        }
      }
      if (isWide(next)) {
        queue.shift();
        // partner: the nearby single with the longest summary (best gap filler)
        let partnerIdx = -1, best = -1;
        for (let i = 0; i < Math.min(queue.length, 4); i++) {
          if (isWide(queue[i])) continue;
          const len = (queue[i].querySelector('.card__summary')?.textContent || '').length;
          if (len > best) { best = len; partnerIdx = i; }
        }
        const partner = partnerIdx >= 0 ? queue.splice(partnerIdx, 1)[0] : null;
        const featuredLeft = featuredRowCount % 2 === 0;
        featuredRowCount++;
        if (nCols >= 3) {
          next.style.gridColumn = featuredLeft ? '1 / span 2' : `${nCols - 1} / span 2`;
          next.style.gridRow = `${row}`;
          if (partner) {
            partner.style.gridColumn = featuredLeft ? `${nCols}` : '1';
            partner.style.gridRow = `${row}`;
            pairs.push({featured: next, single: partner});
          }
        } else {
          // 2-col: featured takes the full row; partner starts the next row
          next.style.gridColumn = '1 / span 2';
          next.style.gridRow = `${row}`;
          if (partner) queue.unshift(partner);
        }
        row++;
      } else {
        // fill a whole row with singles
        for (let c = 0; c < nCols && queue.length; ) {
          const idx = queue.findIndex(q => !isWide(q));
          if (idx === -1) break;
          const card = queue.splice(idx, 1)[0];
          card.style.gridColumn = `${c + 1}`;
          card.style.gridRow = `${row}`;
          c++;
        }
        row++;
      }
    }

    // let the paired single's summary grow into the featured row's height
    const contentH = (card: HTMLElement) => {
      const kids = [...card.children] as HTMLElement[];
      return kids[kids.length - 1].getBoundingClientRect().bottom - kids[0].getBoundingClientRect().top;
    };
    for (const {featured, single} of pairs) {
      const summary = single.querySelector<HTMLElement>('.card__summary');
      if (!summary) continue;
      const spare = contentH(featured) - contentH(single) + summary.getBoundingClientRect().height;
      const lineH = parseFloat(getComputedStyle(summary).lineHeight) || 22;
      summary.style.webkitLineClamp = String(Math.max(2, Math.floor(spare / lineH)));
    }
  }

  function layoutAllGrids() {
    document.querySelectorAll<HTMLElement>('.work-grid').forEach(layoutGrid);
  }

  let masonryRaf = 0;
  function scheduleLayout() {
    cancelAnimationFrame(masonryRaf);
    masonryRaf = requestAnimationFrame(layoutAllGrids);
  }

  document.addEventListener('astro:page-load', () => {
    layoutAllGrids();
    // re-pack once media/fonts settle and on resize
    window.addEventListener('load', scheduleLayout, { once: true });
    (document as any).fonts?.ready?.then(scheduleLayout);
    window.addEventListener('resize', scheduleLayout);
  });

  // Tag filter for the client-work grid
  function initWorkFilter() {
    const section = document.getElementById('client-work');
    if (!section) return;
    const chips = section.querySelectorAll<HTMLButtonElement>('.work-filter__chip');
    const cards = section.querySelectorAll<HTMLElement>('.work-grid .card');
    if (!chips.length) return;

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter;
        chips.forEach(c => {
          const active = c === chip;
          c.classList.toggle('work-filter__chip--active', active);
          c.setAttribute('aria-pressed', String(active));
        });
        cards.forEach(card => {
          const tags = (card.dataset.tags || '').split('|');
          const show = filter === 'all' || tags.includes(filter!);
          card.classList.toggle('card--filtered-out', !show);
        });
        scheduleLayout();
      });
    });
  }
  document.addEventListener('astro:page-load', initWorkFilter);
</script>
