---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path?: string) {
  if (!path || path.startsWith('http')) return path;
  return `${base}${path}`;
}

interface Props {
  src: string;
  title?: string;
  isYoutube?: boolean;
  controls?: boolean;
  playsinline?: boolean;
  autoplay?: boolean;
  muted?: boolean;
  loop?: boolean;
  narrow?: boolean; // for portrait video: cap width and centre
}

const {
  src,
  title = 'Video',
  isYoutube = false,
  controls = true,
  playsinline = true,
  autoplay = false,
  muted = false,
  loop = false,
  narrow = false,
} = Astro.props;
---

{isYoutube ? (
  <div class="case-study-video-wrap">
    <iframe
      src={src}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      class="case-study-iframe"
    ></iframe>
  </div>
) : (
  <video
    src={withBase(src)}
    controls={controls}
    playsinline={playsinline}
    autoplay={autoplay}
    muted={muted}
    loop={loop}
    aria-label={title}
    class:list={['case-study-video', { 'case-study-video--narrow': narrow }]}
  >
    Your browser doesn't support HTML5 video. Here is a <a href={withBase(src)}>link to the video</a> instead.
  </video>
)}

<style>
  .case-study-video {
    width: 100%;
    border-radius: var(--radius-lg);
    margin: var(--space-8) 0;
    display: block;
    background: var(--color-surface);
  }

  .case-study-video--narrow {
    max-width: 22rem;
    margin-inline: auto;
  }

  .case-study-video-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    margin: var(--space-8) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .case-study-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
