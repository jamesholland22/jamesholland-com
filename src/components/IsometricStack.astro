---
// Animated exploded-layer view for isometric design artifacts.
// Takes 2-4 same-size transparent PNGs, bottom layer first; they gently
// separate and reassemble in a loop (static stack under reduced motion).

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http')) return path;
  return `${base}${path}`;
}

interface Props {
  layers: string[];
  alt: string;
  caption?: string;
}

const { layers, alt, caption } = Astro.props;
---

<figure class="iso-figure">
  <div class="iso-stack" role="img" aria-label={alt}>
    {layers.map((src, i) => (
      <img
        src={withBase(src)}
        alt=""
        class="iso-stack__layer"
        style={`--i: ${i}`}
        loading="lazy"
      />
    ))}
  </div>
  {caption && <figcaption class="iso-figure__caption">{caption}</figcaption>}
</figure>

<style>
  .iso-figure {
    margin: var(--space-8) 0;
  }

  .iso-stack {
    position: relative;
    max-width: 30rem;
    margin-inline: auto;
    aspect-ratio: 672 / 490;
    /* headroom so lifted layers don't clip */
    padding-top: 12%;
  }

  .iso-stack__layer {
    position: absolute;
    inset: 12% 0 0 0;
    width: 100%;
    animation: iso-lift 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 120ms);
  }

  @keyframes iso-lift {
    0%, 15% {
      transform: translateY(0);
    }
    50%, 65% {
      transform: translateY(calc(var(--i) * -9%));
    }
    100% {
      transform: translateY(0);
    }
  }

  .iso-figure__caption {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .iso-stack__layer {
      animation: none;
      transform: translateY(calc(var(--i) * -6%));
    }
  }
</style>
