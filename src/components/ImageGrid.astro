---
// Simple responsive image row/grid for case study bodies.

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http')) return path;
  return `${base}${path}`;
}

interface Item {
  src: string;
  alt: string;
}

interface Props {
  images: Item[];
  caption?: string;
}

const { images, caption } = Astro.props;
---

<figure class="image-grid-figure">
  <div class="image-grid" style={`--cols: ${images.length}`}>
    {images.map(({ src, alt }) => (
      <img src={withBase(src)} alt={alt} loading="lazy" class="image-grid__img" />
    ))}
  </div>
  {caption && <figcaption class="image-grid-figure__caption">{caption}</figcaption>}
</figure>

<style>
  .image-grid-figure {
    margin: var(--space-8) 0;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .image-grid__img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .image-grid-figure__caption {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  @media (max-width: 480px) {
    .image-grid {
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    }
  }
</style>
