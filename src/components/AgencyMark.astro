---
// Small agency logo attribution. Logos live in /public/images/agencies as
// black-on-transparent PNGs normalised so each wordmark's letter-body band is
// centred on the canvas — so a flex-centred image lines up with adjacent text.

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  agency?: string;
  size?: 'sm' | 'md';
}

const { agency, size = 'sm' } = Astro.props;
const slug = agency?.toLowerCase();
---

{agency && (
  <img
    src={`${base}/images/agencies/${slug}.png`}
    alt={agency}
    class:list={['agency-mark', `agency-mark--${size}`]}
    loading="lazy"
  />
)}

<style>
  .agency-mark {
    display: inline-block;
    width: auto;
    flex: 0 0 auto; /* never let flex parents squish the mark */
    opacity: 0.6;
    vertical-align: middle;
    /* mathematically the body centres on the middot at -0.06em, but it reads
       too high; optically it sits better ~2.5px (at 12px) lower */
    position: relative;
    top: 0.15em;
  }

  /* canvas is 120px with a 50px letter-body band centred on it; 1.6em makes
     that band roughly the cap height of the surrounding text */
  .agency-mark--sm { height: 1.6em; }
  .agency-mark--md { height: 1.6em; }
</style>
